Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Jede", " ", "Spalte", " ", "separat", " ", "standardisieren"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"standardizedData", "=", 
     RowBox[{"Standardize", "[", "measurements", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Jede", " ", "Zeile", " ", "ausdr\[UDoubleDot]cklich", " ", "als", " ", 
     "einen", " ", "vierdimensionalen", " ", "Datenpunkt", " ", "behandeln"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clusterIDs", "=", 
     RowBox[{"ClusteringComponents", "[", 
      RowBox[{"standardizedData", ",", "3", ",", "1", ",", 
       RowBox[{"DistanceFunction", "->", "EuclideanDistance"}], ",", 
       RowBox[{"Method", "->", "\"\<KMeans\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Dimensions", "[", "clusterIDs", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clusterGroups", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Pick", "[", 
        RowBox[{"plotPoints", ",", "clusterIDs", ",", "clusterNumber"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"clusterNumber", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clusterPlot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"clusterGroups", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", 
            RowBox[{"PointSize", "[", "0.018", "]"}]}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", 
            RowBox[{"PointSize", "[", "0.018", "]"}]}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Darker", "[", "Green", "]"}], ",", 
            RowBox[{"PointSize", "[", "0.018", "]"}]}], "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Erkanntes Cluster 1\>\"", 
          ",", "\"\<Erkanntes Cluster 2\>\"", 
          ",", "\"\<Erkanntes Cluster 3\>\""}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Bl\[UDoubleDot]tenblattl\[ADoubleDot]nge in cm\>\"", 
          ",", "\"\<Bl\[UDoubleDot]tenblattbreite in cm\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Machine Learning erkennt Gruppen anhand der \
Messwerte\>\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]",
    "clusterPlot"}]}]], "Input",
