         RowBox[{"Red", ",", "Thick"}], "}"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Tikhonov", " ", "regularization", " ", "includes", " ", "a", " ", 
     "Tikhonov", " ", "matrix", " ", "Ti", " ", "in", " ", 
     RowBox[{"minimization", ":", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"A", ".", "beta"}], " ", "-", " ", "y", " ", "+", " ", 
       RowBox[{
        RowBox[{"Ti", ".", "y"}], "\[IndentingNewLine]", "We", " ", "need", 
        " ", "to", " ", "solve"}]}], ":", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"AT", ".", "A"}], "+", 
         RowBox[{"TiT", ".", "Ti"}]}], ")"}], ".", "beta"}]}]}], " ", "=", 
    " ", 
    RowBox[{"AT", ".", "y"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Use", " ", "ConstantArray", " ", "to", " ", "generate", " ", "a", " ", 
    "toeplitz", " ", "matrix"}], "\[IndentingNewLine]", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ti", " ", "=", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "20"}], "}"}], ",", "size"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"beta", " ", "=", " ", 
   RowBox[{"LinearSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "A", "]"}], ".", "A"}], "+", 
      RowBox[{
       RowBox[{"Transpose", "[", "Ti", "]"}], ".", "Ti"}]}], ",", 
     RowBox[{
      RowBox[{"Transpose", "[", "A", "]"}], ".", "y"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tikhonovRegr", "[", "x_", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Part", "[", 
      RowBox[{"beta", ",", "2"}], "]"}], "x"}], " ", "+", 
    RowBox[{"Part", "[", 
     RowBox[{"beta", ",", "1"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotTikhonovRegr", " ", "=", " ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"tikhonovRegr", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "size"}], "}"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"Green", ",", "Thick"}], "}"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
