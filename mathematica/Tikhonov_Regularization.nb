Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"vertices", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"x", "=", "0"}], ",", 
   RowBox[{"x", "<", "500"}], ",", 
   RowBox[{"x", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y", "=", "x"}], ";", "\[IndentingNewLine]", 
    RowBox[{"minErr", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"maxErr", " ", "=", "40"}], ";", "\[IndentingNewLine]", 
    RowBox[{"errAdd", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"errMult", " ", "=", " ", "1.1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"x", "\[GreaterEqual]", "150"}], ",", 
      RowBox[{
       RowBox[{"minErr", "=", "20"}], ";", " ", 
       RowBox[{"maxErr", "=", "80"}], ";", " ", 
       RowBox[{"errMult", "=", "1.4"}], ";"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"x", "\[GreaterEqual]", "300"}], ",", 
      RowBox[{
       RowBox[{"minErr", "=", "40"}], ";", " ", 
       RowBox[{"maxErr", "=", "120"}], ";", " ", 
       RowBox[{"errMult", "=", "1.6"}], ";"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"StringJoin", "[", 
        RowBox[{
         RowBox[{"ToString", "[", "x", "]"}], ",", "\"\< \>\"", ",", 
         RowBox[{"ToString", "[", "minErr", "]"}], " ", ",", " ", "\"\< \>\"",
          " ", ",", " ", 
         RowBox[{"ToString", "[", "maxErr", "]"}]}], "]"}], "]"}], ";"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"maxErr", "\[GreaterEqual]", "0"}], ",", 
      RowBox[{
       RowBox[{"errAdd", "=", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"minErr", ",", "maxErr"}], "}"}], "]"}]}], ";"}]}], "]"}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"vertices", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"errMult", "*", "y"}], "+", "errAdd"}]}], "}"}]}], "]"}], 
    ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"size", " ", "=", " ", 
    RowBox[{"Length", "[", "vertices", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotVertices", " ", "=", " ", 
    RowBox[{"ListPlot", "[", "vertices", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"A", ".", "alpha"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"y", "\[IndentingNewLine]", "To", " ", "minimize", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", ".", "alpha"}], " ", "-", " ", "y"}], ")"}], " ", "we", 
      " ", "solve", " ", "the", " ", "Gaussian", " ", "Normal", " ", 
      RowBox[{"Equation", ":", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"AT", ".", "A"}], ")"}], ".", "alpha"}]}]}], " ", "=", " ", 
     RowBox[{"AT", ".", "y"}]}]}], "\[IndentingNewLine]", " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Define", " ", "A"}], ",", " ", "y"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"x", "=", "0"}], ",", 
    RowBox[{"x", "<", "size"}], ",", 
    RowBox[{"x", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Indices", " ", "are", " ", "not", " ", "zero", " ", "based"}], 
     " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"A", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"Part", "[", 
          RowBox[{"vertices", ",", 
           RowBox[{"x", "+", "1"}], ",", "1"}], "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"y", ",", 
       RowBox[{"Part", "[", 
        RowBox[{"vertices", ",", 
         RowBox[{"x", "+", "1"}], ",", "2"}], "]"}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Print", "[", "A", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Solve", " ", "Gaussian", " ", "Normal", " ", "Equation", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{"m", ",", "b"}], "]"}], " ", "finds", " ", "an", " ", "x", " ", 
     "that", " ", "solves", " ", 
     RowBox[{"m", ".", "x"}]}], "\[Equal]", "b"}], "\[IndentingNewLine]", " ",
    "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alpha", "=", 
    RowBox[{"LinearSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "A", "]"}], ".", "A"}], ",", 
      RowBox[{
       RowBox[{"Transpose", "[", "A", "]"}], ".", "y"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Print", "[", "alpha", "]"}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearRegr", "[", "x_", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Part", "[", 
      RowBox[{"alpha", ",", "2"}], "]"}], "x"}], " ", "+", 
    RowBox[{"Part", "[", 
     RowBox[{"alpha", ",", "1"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotLinearRegr", " ", "=", " ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"linearRegr", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "size"}], "}"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
